# ==============================================================================
# Enterprise Knowledge Agent - Environment Configuration
# ==============================================================================

# Core Application
APP_NAME=Enterprise Knowledge Agent
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json
DEFAULT_TENANT_ID=tenant-nimbus-default

# Security & Authentication
JWT_SECRET_KEY=change-me-in-production-use-strong-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL / SQLite fallback for local test mode)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_agent
DATABASE_TEST_URL=sqlite+aiosqlite:///./test_enterprise_agent.db

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_documents
QDRANT_VECTOR_SIZE=1024
QDRANT_USE_IN_MEMORY=false

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92

# LLM & Model Settings (LiteLLM provider-agnostic)
LLM_PROVIDER=litellm
LLM_PRIMARY_MODEL=gemini/gemini-1.5-pro
LLM_FAST_MODEL=gemini/gemini-1.5-flash
LLM_LOCAL_OLLAMA_URL=http://localhost:11434
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding & Reranker Models
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# Ingestion & Connectors
SAMPLE_CORPUS_DIR=./data/sample_corpus

# Observability (OpenTelemetry & Langfuse)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# MCP (Model Context Protocol) Server
MCP_SERVER_PORT=8005
MCP_SERVER_HOST=0.0.0.0

# Rate Limiting & Budgets
RATE_LIMIT_REQUESTS_PER_MINUTE=60
AGENT_MAX_ITERATIONS=5
AGENT_MAX_EXECUTION_TIME_SECONDS=45
AGENT_BUDGET_USD_PER_QUERY=0.10

